// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Session pooler (port 5432) for `prisma db push`, which the transaction pooler can't run.
  directUrl = env("DIRECT_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // User specific fields for GoRoam
  credits       Int       @default(1)
  // When the welcome email went out (null: not yet). Lets every sign-in path retry it safely, once.
  welcomeSentAt DateTime?
  // When they finished the first-sign-in "What should we call you?" step (null: not yet).
  onboardedAt   DateTime?
  subscription  String?   @default("free")
  // A Week or Year Pass: unlimited trips (fair use) until this moment.
  passUntil     DateTime?
  passPlan      String?   // "week" or "year"
  
  accounts Account[]
  sessions Session[]
  itineraries Itinerary[]
  payments Payment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// GoRoam specific models
model Itinerary {
  id              String   @id @default(cuid())
  title           String?
  destination     String
  startDate       DateTime
  endDate         DateTime
  numberOfDays    Int
  budget          Float
  numberOfPeople  Int
  tripType        String   // 'national' or 'international'
  interests       String   // JSON string array of interests
  itineraryData   String   // JSON string of the complete itinerary
  status          String   @default("completed") // 'pending', 'completed', 'failed'
  pdfUrl          String?
  chatCount       Int      @default(0) // questions asked to the trip's AI concierge
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // WhatsApp morning messages: local hour to send at, and the trip's time zone (IANA).
  whatsappHour    Int      @default(7)
  timezone        String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappSubs  WhatsAppSub[]
}

// One row per credit-pack purchase. Written only by the payment webhook, so the
// unique provider id makes a retried webhook a no-op instead of double credits.
model Payment {
  id                String   @id @default(cuid())
  provider          String   @default("dodo")
  providerPaymentId String   @unique
  checkoutSessionId String?
  userId            String
  planId            String   // 'starter' | 'explorer' | 'adventurer'
  credits           Int      // credits this purchase added
  amount            Int      // total charged, in the currency's smallest unit
  currency          String
  status            String   @default("succeeded") // 'succeeded' | 'refunded' | 'disputed'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A first trip made from the landing page before signing in. Days 2+ stay locked
// until the traveller signs in and claims it, which copies it into an Itinerary.
model GuestTrip {
  id                 String   @id @default(cuid())
  destination        String
  startDate          DateTime
  numberOfDays       Int
  budget             Float
  numberOfPeople     Int
  tripType           String
  interests          String   // JSON string array
  itineraryData      String   // JSON string of the full itinerary
  ipHash             String
  deviceId           String
  claimedByUserId    String?
  claimedItineraryId String?
  createdAt          DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([deviceId])
  @@index([claimedByUserId])
}

// Someone getting a trip's day plan on WhatsApp each morning of the trip.
// Numbers are verified with a code first; replying STOP ends it.
model WhatsAppSub {
  id          String    @id @default(cuid())
  itineraryId String
  phone       String    // E.164 digits, no "+"
  name        String?
  verified    Boolean   @default(false)
  codeHash    String?
  codeExpires DateTime?
  attempts    Int       @default(0)
  optedInAt   DateTime?
  stoppedAt   DateTime?
  lastSentDay String?   // the local date (YYYY-MM-DD) of the last morning message
  createdAt   DateTime  @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, phone])
  @@index([phone])
}

// Squad Match: one link a group shares to decide where, when and for how much.
// Nobody signs in; each friend's browser keeps a token to change their answers.
model Squad {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  ipHash    String
  createdAt DateTime      @default(now())
  members   SquadMember[]

  @@index([ipHash, createdAt])
}

model SquadMember {
  id        String   @id @default(cuid())
  squadId   String
  token     String   @unique
  name      String
  homeCity  String
  // Each friend's private ceiling per person for the whole trip, in INR. Never sent to anyone.
  maxBudget Float
  dates     String   // JSON: the Fridays (YYYY-MM-DD) they're free
  likes     String   // JSON: trip slugs swiped right
  passes    String   // JSON: trip slugs swiped left
  vibes     String   // JSON: the vibes they picked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@index([squadId])
}
